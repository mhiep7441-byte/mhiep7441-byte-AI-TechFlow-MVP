DATABASE_URL=jdbc:postgresql://localhost:5432/techflow
DATABASE_USERNAME=techflow
DATABASE_PASSWORD=techflow_dev
SERVER_PORT=8080
TECHFLOW_PROJECT_DIR=..
TECHFLOW_PYTHON_COMMAND=python
TECHFLOW_WORKER_SCRIPT=video_worker.py
TECHFLOW_ADMIN_EMAIL=admin@techflow.local
TECHFLOW_ADMIN_PASSWORD=replace-with-a-long-random-password
TECHFLOW_ADMIN_NAME=TechFlow Admin
SESSION_COOKIE_SECURE=false

# Chỉ cấu hình qua biến môi trường, không commit giá trị thật.
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_ID=
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_SECRET=
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_RESEARCH_MODEL=gpt-5.6-terra
OPENAI_SCRIPT_MODEL=gpt-5.6-terra
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
ENABLE_AI_IMAGES=true
MAX_AI_IMAGES=4
CLOUDINARY_URL=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8080/oauth/tiktok/callback
# Generate at least 32 random characters; this encrypts TikTok OAuth tokens at rest.
TECHFLOW_TOKEN_ENCRYPTION_KEY=
